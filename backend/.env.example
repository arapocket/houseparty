ENV=dev
DATABASE_URL=postgresql+asyncpg://houseparty:houseparty@localhost:5432/houseparty
# Production needs real values here: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-do-not-use-in-production
ACCESS_TOKEN_TTL_MINUTES=43200

# Leave empty in dev: verification codes are printed to the console instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

ADMIN_SESSION_SECRET=dev-only-admin-secret-do-not-use-in-production
ADMIN_USERNAME=admin
# The admin page at /admin refuses all logins until this is set.
ADMIN_PASSWORD=

# Photos. Dev defaults need no accounts: files go in backend/uploads and
# every photo passes moderation.
PUBLIC_BASE_URL=http://localhost:8000
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
MODERATION_BACKEND=off
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
